---
// src/layouts/MainLayout.astro
import '../styles/global.css';
// description prop'u eklendi
const { 
  title = "ANS DataTech | Veri ve Bilişim Sistemleri",
  description = "ANS DataTech; 17 yıllık tecrübe ile veri analizi, kurumsal web siteleri ve özel web uygulamaları (SaaS) geliştiren dijital mimari merkezidir."
} = Astro.props;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- SEO Meta Etiketleri -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="ANS DataTech" />
    
    <!-- Google Search Console Doğrulama Kodu (Adım 4'te alacağınız kod buraya gelecek) -->
    <!-- <meta name="google-site-verification" content="google-site-verification=Z8pXbj_mkVwdNsCvNuHV_45OQDPwVqxX-vTzKSyE7tk" /> -->
  </head>
  <!-- Koyu Tema Arka Planı -->
  <body class="bg-[#0b1120] text-slate-300 font-sans antialiased selection:bg-cyan-500 selection:text-slate-900">
    
    <!-- ÜST MENÜ -->
    <header class="border-b border-slate-800 bg-[#0f172a]/95 backdrop-blur-md fixed top-0 w-full z-50 transition-all shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- LOGO VE METİN (Mobilde de Görünecek Şekilde Güncellendi) -->
        <a href="/" class="flex items-center gap-2 sm:gap-3 group py-2">
          <img src="/logo_2.png" alt="ANS DataTech Logo" class="h-12 sm:h-14 md:h-16 w-auto object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_0_10px_rgba(6,182,212,0.3)]" />
          
          <span class="text-xl sm:text-3xl font-extrabold tracking-tight text-white flex items-center">
            ANS <span class="text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.4)] ml-1">DataTech</span><span class="text-cyan-400 font-black text-2xl sm:text-4xl leading-none">.</span>
          </span>
        </a>

        <!-- MASAÜSTÜ MENÜ -->
        <nav class="hidden md:flex gap-8 text-sm font-bold tracking-wide text-slate-300">
          <a href="/hizmetler" class="hover:text-cyan-400 transition-colors">Hizmetlerimiz</a>
          <a href="/projeler" class="hover:text-cyan-400 transition-colors">Neler Yaptık?</a>
          <a href="/iletisim" class="hover:text-cyan-400 transition-colors">İletişim</a>
        </nav>

        <!-- MOBİL MENÜ BUTONU (HAMBURGER) -->
        <button id="menu-btn" aria-label="Menüyü Aç/Kapat" class="md:hidden text-slate-300 hover:text-cyan-400 focus:outline-none p-2">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </div>

      <!-- MOBİL AÇILIR MENÜ (Başlangıçta Gizli) -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#0f172a] border-b border-slate-800 px-4 pt-2 pb-6 space-y-3 shadow-xl">
        <a href="/hizmetler" class="block py-2 text-base font-bold text-slate-300 hover:text-cyan-400 transition-colors border-b border-slate-800/50">Hizmetlerimiz</a>
        <a href="/projeler" class="block py-2 text-base font-bold text-slate-300 hover:text-cyan-400 transition-colors border-b border-slate-800/50">Neler Yaptık?</a>
        <a href="/iletisim" class="block py-2 text-base font-bold text-slate-300 hover:text-cyan-400 transition-colors">İletişim</a>
      </div>
    </header>

    <main class="pt-20 min-h-screen relative overflow-hidden">
      <!-- DEVASA SİBER FİLİGRAN -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] md:w-[800px] md:h-[800px] opacity-[0.03] pointer-events-none flex items-center justify-center -z-10">
         <img src="/logo_2.png" alt="" class="w-full h-full object-contain" />
      </div>
      
      <slot />
    </main>

    <!-- WHATSAPP CANLI DESTEK BUTONU -->
    <a href="https://wa.me/905072411802" target="_blank" rel="noopener noreferrer" class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#20b858] text-white p-4 rounded-full shadow-[0_0_20px_rgba(37,211,102,0.3)] hover:shadow-[0_0_30px_rgba(37,211,102,0.5)] transition-all duration-300 hover:-translate-y-1 group flex items-center justify-center">
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="absolute right-16 bg-slate-900 text-white text-xs font-bold py-1.5 px-3 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-slate-700 pointer-events-none">Hızlı Destek</span>
    </a>

    <!-- ALT MENÜ (FOOTER) -->
    <footer class="border-t border-slate-800 bg-[#0f172a] pt-12 pb-8 mt-12 shadow-[0_-10px_40px_rgba(0,0,0,0.3)] relative z-10">
      <div class="max-w-7xl mx-auto px-4 flex flex-col items-center">
        <div class="flex items-center gap-3 mb-6 opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500 cursor-pointer">
           <img src="/logo_2.png" alt="ANS DataTech" class="h-10 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)]" />
           <span class="text-xl font-extrabold tracking-tight text-white">
              ANS <span class="text-cyan-400">DataTech</span><span class="text-cyan-400 font-black">.</span>
           </span>
        </div>

        <div class="flex flex-wrap justify-center gap-4 md:gap-8 mb-8 text-xs font-semibold tracking-wider text-slate-500 uppercase">
           <a href="/kvkk" class="hover:text-cyan-400 transition-colors">KVKK Aydınlatma Metni</a>
           <a href="/gizlilik-politikasi" class="hover:text-cyan-400 transition-colors">Gizlilik Politikası</a>
           <a href="/cerez-politikasi" class="hover:text-cyan-400 transition-colors">Çerez Politikası</a>
        </div>

        <p class="text-center text-slate-500 text-sm font-medium">&copy; {new Date().getFullYear()} ANS DataTech. Tüm hakları saklıdır.</p>
      </div>
    </footer>

    <!-- MOBİL MENÜ AÇMA/KAPAMA SCRİPTİ -->
    <script>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>

  </body>
</html>