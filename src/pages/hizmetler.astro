---
// src/pages/hizmetler.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Hizmetlerimiz | ANS DataTech">
  
  <!-- Siber Noktalı Arka Plan -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-30 pointer-events-none"></div>

  <section class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24">
    
    <!-- Karanlık Tema Üst Başlık -->
    <div class="text-center max-w-3xl mx-auto mb-24">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700 text-cyan-400 text-sm font-semibold shadow-sm mb-6 backdrop-blur-sm">
        <span class="flex h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#22d3ee]"></span>
        Uzmanlık Alanlarımız
      </div>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6">Uçtan Uca Dijital Dönüşüm</h1>
      <p class="text-lg text-slate-400 font-medium leading-relaxed">İşletmenizin dijital ayak izini oluşturuyor, operasyonlarınızı özel yazılımlarla otomatikleştiriyor ve ham verilerinizi akademik bir hassasiyetle modelliyoruz.</p>
    </div>

    <!-- Hizmetler Listesi (Arka plan şeffaf yapıldı, filigran görünecek) -->
    <div class="space-y-32 bg-transparent relative z-10">
      
      <!-- HİZMET 1: Kurumsal Web Siteleri (Kadızade ve Bek Akademi Referanslı) -->
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16 group">
        <div class="lg:w-1/2 space-y-5">
          <div class="w-12 h-12 bg-[#0f172a] text-cyan-400 rounded-xl flex items-center justify-center shadow-[0_0_15px_rgba(6,182,212,0.15)] border border-slate-700 group-hover:border-cyan-500/50 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h2 class="text-3xl font-extrabold text-white">Kurumsal Web Siteleri & Blog Mimarisi</h2>
          <p class="text-lg text-slate-400 font-medium leading-relaxed">
            Markanızın felsefesini dijital dünyaya yansıtan, yüksek performanslı web vitrinleri inşa ediyoruz. Klasik şablonlardan uzak, tamamen markanıza özel tasarlanmış, arama motorlarında (SEO) üst sıraları hedefleyen modern mimariler sunuyoruz.
          </p>
          <ul class="space-y-3 pt-2">
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-cyan-400 drop-shadow-[0_0_5px_rgba(34,211,238,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Ultra Hızlı Yükleme (Astro.js Mimarisi)</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-cyan-400 drop-shadow-[0_0_5px_rgba(34,211,238,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> İçerik ve Blog Yönetim Sistemleri</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-cyan-400 drop-shadow-[0_0_5px_rgba(34,211,238,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Gelişmiş SEO Altyapısı</li>
          </ul>
        </div>
        
        <div class="lg:w-1/2 w-full flex justify-center lg:justify-end relative perspective-1000">
           <div class="absolute inset-0 bg-cyan-500/10 rounded-2xl blur-3xl group-hover:bg-cyan-500/20 transition-colors duration-700 -z-10"></div>
           <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=800&auto=format&fit=crop" alt="Kurumsal Web Tasarımı" class="rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] w-full max-w-md aspect-video object-cover border border-slate-700 hover:-translate-y-1 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
        </div>
      </div>

      <!-- HİZMET 2: PWA Web Uygulamaları (Ahalteke Referanslı) -->
      <div class="flex flex-col lg:flex-row-reverse items-center gap-12 lg:gap-16 group">
        <div class="lg:w-1/2 space-y-5">
          <div class="w-12 h-12 bg-[#0f172a] text-blue-400 rounded-xl flex items-center justify-center shadow-[0_0_15px_rgba(59,130,246,0.15)] border border-slate-700 group-hover:border-blue-500/50 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <h2 class="text-3xl font-extrabold text-white">Özel Web Uygulamaları (SaaS & PWA)</h2>
          <p class="text-lg text-slate-400 font-medium leading-relaxed">
            Standart paketlere sığmayan karmaşık operasyonlarınızı, size özel bulut tabanlı sistemlere dönüştürüyoruz. Rezervasyon modülleri, canlı skor/veri takibi ve kompleks algoritmaları (kura eşleştirme vb.) doğrudan cep telefonuna indirilebilir şekilde (PWA) sunuyoruz.
          </p>
          <ul class="space-y-3 pt-2">
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-blue-400 drop-shadow-[0_0_5px_rgba(59,130,246,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Modüler Otomasyon Panelleri</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-blue-400 drop-shadow-[0_0_5px_rgba(59,130,246,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Güvenli Veritabanı Mimarisi (Supabase/PostgreSQL)</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-blue-400 drop-shadow-[0_0_5px_rgba(59,130,246,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Kuruma Özel Algoritma Geliştirme</li>
          </ul>
        </div>
        
        <div class="lg:w-1/2 w-full flex justify-center lg:justify-start relative perspective-1000">
           <div class="absolute inset-0 bg-blue-500/10 rounded-2xl blur-3xl group-hover:bg-blue-500/20 transition-colors duration-700 -z-10"></div>
           <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop" alt="Web Uygulamaları Yönetim Paneli" class="rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] w-full max-w-md aspect-video object-cover border border-slate-700 hover:-translate-y-1 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
        </div>
      </div>

      <!-- HİZMET 3: Veri Analizi ve İstatistik (u5mTürkiye Referanslı) -->
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16 group">
        <div class="lg:w-1/2 space-y-5">
          <div class="w-12 h-12 bg-[#0f172a] text-purple-400 rounded-xl flex items-center justify-center shadow-[0_0_15px_rgba(168,85,247,0.15)] border border-slate-700 group-hover:border-purple-500/50 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h2 class="text-3xl font-extrabold text-white">Akademik Veri Analizi & İstatistik</h2>
          <p class="text-lg text-slate-400 font-medium leading-relaxed">
            PhD düzeyindeki analitik disiplinimizle, verilerinizi sadece grafiklere dökmüyor; onları okuyor ve modelliyoruz. Demografik analizleri, zaman serilerini ve ham veri setlerinizi işleyerek interaktif ve harita bazlı dashboard'lara dönüştürüyoruz.
          </p>
          <ul class="space-y-3 pt-2">
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-purple-400 drop-shadow-[0_0_5px_rgba(168,85,247,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Python ve R ile İleri İstatistiksel Analiz</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-purple-400 drop-shadow-[0_0_5px_rgba(168,85,247,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Dinamik Veri Görselleştirme (Tableau vb.)</li>
             <li class="flex items-center gap-3 text-slate-300 font-medium"><svg class="w-5 h-5 text-purple-400 drop-shadow-[0_0_5px_rgba(168,85,247,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg> Gelecek Projeksiyonu ve Tahminleme (Forecasting)</li>
          </ul>
        </div>
        
        <div class="lg:w-1/2 w-full flex justify-center lg:justify-end relative perspective-1000">
           <div class="absolute inset-0 bg-purple-500/10 rounded-2xl blur-3xl group-hover:bg-purple-500/20 transition-colors duration-700 -z-10"></div>
           <img src="https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?q=80&w=800&auto=format&fit=crop" alt="Veri Analizi ve İstatistik" class="rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] w-full max-w-md aspect-video object-cover border border-slate-700 hover:-translate-y-1 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
        </div>
      </div>

    </div>
  </section>

  <!-- KARANLIK TEMA CTA (Ortak Harekete Geçirici Kutu) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 relative z-10 mt-12 bg-transparent">
    <div class="max-w-5xl mx-auto rounded-3xl p-10 lg:p-14 text-center shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden bg-[#0f172a] border border-slate-800">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-950"></div>
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-900/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4">
          Projeniz İçin Hazır Mısınız?
        </h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-8 font-medium leading-relaxed">
          Siz işinize odaklanın, dijital mimarinizi ve veri altyapınızı biz inşa edelim.
        </p>
        <a href="/iletisim" class="inline-flex items-center gap-2 px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 rounded-xl font-extrabold transition-transform hover:-translate-y-1 shadow-[0_0_15px_rgba(6,182,212,0.4)]">
          Projeyi Konuşalım
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>
  </section>

</MainLayout>