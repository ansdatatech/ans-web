---
// src/pages/projeler.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Neler Yaptık? | ANS DataTech">
  
  <!-- Siber Noktalı Arka Plan -->
  <div class="absolute inset-0 z-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-30 pointer-events-none"></div>

  <section class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24">
    
    <!-- Ortalanmış Başlık ve Neon Rozet -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700 text-cyan-400 text-sm font-semibold shadow-sm mb-6 backdrop-blur-sm">
        <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#22d3ee]"></span>
        Başarı Hikayelerimiz
      </div>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6">Neler Yaptık?</h1>
      <p class="text-lg text-slate-400 font-medium">Karmaşık süreçleri basit, şık ve güçlü dijital ürünlere dönüştürüyoruz. İstediğiniz projenin detaylarını ve canlı versiyonunu inceleyebilirsiniz.</p>
    </div>

    <div class="max-w-6xl mx-auto space-y-12">

      <!-- AMİRAL GEMİSİ PROJE (Öne Çıkan): AHALTEKE -->
      <div class="bg-[#0f172a] border border-slate-800 rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] group relative">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
        
        <div class="flex flex-col lg:flex-row">
          <!-- Görsel Alanı (Masaüstü ve Mobil Kombinasyonu) -->
          <div class="lg:w-1/2 relative bg-slate-900 border-b lg:border-b-0 lg:border-r border-slate-800 p-6 sm:p-10 flex items-center justify-center min-h-[300px] overflow-hidden">
             <!-- Arka Plan Websitesi (Bulanık) -->
             <img src="/ahal-web.jpg" class="absolute inset-0 w-full h-full object-cover opacity-20 blur-sm pointer-events-none" alt="Ahalteke Arka Plan" />
             
             <!-- Önde Yönetim Paneli (Masaüstü) - TIKLANABİLİR -->
             <div class="relative w-full max-w-md rounded-xl overflow-hidden border border-slate-700 shadow-2xl transform transition-transform duration-700 group-hover:-translate-y-2 group-hover:scale-105 z-10 cursor-zoom-in">
                <div class="bg-slate-800 px-3 py-2 flex gap-1.5 pointer-events-none">
                   <div class="w-2.5 h-2.5 rounded-full bg-slate-600"></div>
                   <div class="w-2.5 h-2.5 rounded-full bg-slate-600"></div>
                   <div class="w-2.5 h-2.5 rounded-full bg-slate-600"></div>
                </div>
                <img src="/ahal-yonetim.png" class="w-full object-cover bg-white pointer-events-auto" alt="Ahalteke Yönetim Paneli" data-lightbox />
             </div>

             <!-- Üzerine Binen Mobil Uygulama Ekranı - TIKLANABİLİR -->
             <div class="absolute bottom-4 right-4 sm:bottom-8 sm:right-8 w-24 sm:w-32 rounded-2xl overflow-hidden border-[4px] border-slate-800 shadow-2xl transform transition-transform duration-700 group-hover:-translate-y-4 z-20 cursor-zoom-in">
                <img src="/ahal-hakem.jpeg" class="w-full h-auto object-cover pointer-events-auto" alt="Ahalteke Mobil Hakem" data-lightbox />
             </div>
          </div>
          
          <!-- İçerik Alanı -->
          <div class="lg:w-1/2 p-8 lg:p-12 relative z-10 flex flex-col justify-center">
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2.5 py-1 bg-cyan-950 text-cyan-400 text-[10px] font-bold tracking-wider uppercase rounded border border-cyan-900">Uçtan Uca SaaS</span>
              <span class="px-2.5 py-1 bg-slate-900 text-slate-400 text-[10px] font-bold tracking-wider uppercase rounded border border-slate-800">Otomasyon</span>
            </div>
            
            <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4 group-hover:text-cyan-400 transition-colors">Ahalteke Kulüp ve Turnuva Yönetim Sistemi</h2>
            <p class="text-slate-400 font-medium mb-6 leading-relaxed">
              Tenis kulüpleri için sıfırdan geliştirilen kapsamlı dijital ekosistem. Üye yönetiminden canlı skor girişine kadar kulübün tüm operasyonel yükünü tek bir platformda toplar.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-4 mb-8">
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Kapsamlı Kulüp Yönetimi
               </div>
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Dinamik Kort Rezervasyonu
               </div>
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Lig & Ana Tablo Fikstürleri
               </div>
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Algoritmik Kura Eşleştirme
               </div>
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Hakem Canlı Skor Modülü
               </div>
               <div class="flex items-center gap-2.5 text-slate-300 text-sm font-semibold">
                 <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Oyuncu Portalı ve Analiz
               </div>
            </div>

            <div>
              <a href="https://www.ahalteketeniskulubu.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-500/10 text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 rounded-xl font-bold transition-all border border-cyan-500/20">
                Canlı Projeyi İncele
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- DİĞER PROJELER (Karanlık Kompakt Izgara) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- u5mTürkiye -->
        <div class="bg-[#0f172a] border border-slate-800 rounded-xl p-6 flex flex-col sm:flex-row items-start gap-6 hover:border-blue-500/50 hover:shadow-[0_0_20px_rgba(59,130,246,0.1)] transition-all group lg:col-span-2">
           <div class="w-full sm:w-64 h-48 sm:h-36 flex-shrink-0 rounded-lg overflow-hidden bg-slate-900 border border-slate-800 flex cursor-zoom-in">
             <!-- Sol Taraf: Harita -->
             <img src="/u5m-map.png" class="w-1/2 h-full object-cover border-r border-slate-800 opacity-90 group-hover:opacity-100 transition-opacity" alt="u5mTürkiye Harita" data-lightbox />
             <!-- Sağ Taraf: Yeni Grafik Görseli -->
             <img src="/u5m-graph.png" class="w-1/2 h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" alt="u5mTürkiye Grafik" data-lightbox />
           </div>
           <div class="flex flex-col h-full justify-center">
              <div>
                <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider bg-blue-950 px-2 py-0.5 rounded border border-blue-900">Veri Analizi</span>
                <h3 class="text-xl font-bold text-white mt-2 group-hover:text-blue-400 transition-colors leading-tight">u5mTürkiye Araştırma Platformu</h3>
                <p class="text-sm text-slate-400 mt-2 leading-relaxed">Beş yaş altı ölüm hızı verilerinin akademik düzeyde işlendiği; zaman serileri ve harita bazlı interaktif görselleştirme portalı.</p>
              </div>
              <a href="https://u5mturkiye.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-blue-400 hover:text-blue-300 font-semibold text-sm mt-4 transition-colors">
                Platforma Git <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
           </div>
        </div>
        
        <!-- Kadızade -->
        <div class="bg-[#0f172a] border border-slate-800 rounded-xl p-6 flex flex-col sm:flex-row items-start gap-6 hover:border-purple-500/50 hover:shadow-[0_0_20px_rgba(168,85,247,0.1)] transition-all group lg:col-span-2">
           <div class="w-full sm:w-64 h-48 sm:h-36 flex-shrink-0 rounded-lg overflow-hidden bg-slate-900 border border-slate-800 flex cursor-zoom-in">
             <img src="/kadizade-web.png" class="w-1/2 h-full object-cover border-r border-slate-800 opacity-90 group-hover:opacity-100 transition-opacity" alt="Kadızade Web" data-lightbox />
             <img src="/kadizade-blog.png" class="w-1/2 h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" alt="Kadızade Blog" data-lightbox />
           </div>
           <div class="flex flex-col h-full justify-center">
              <div>
                <span class="text-[10px] font-bold text-purple-400 uppercase tracking-wider bg-purple-950 px-2 py-0.5 rounded border border-purple-900">Kurumsal Web & Blog</span>
                <h3 class="text-xl font-bold text-white mt-2 group-hover:text-purple-400 transition-colors leading-tight">Kadızade Dijital Vitrin</h3>
                <p class="text-sm text-slate-400 mt-2 leading-relaxed max-w-3xl">Yüksek SEO performansına sahip, işletmenin dijital kimliğini ve "Sepetçinin Defteri" adlı blog mimarisini modern bir arayüzle sunan kurumsal web projesi.</p>
              </div>
              <a href="https://www.kadizade.net" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-purple-400 hover:text-purple-300 font-semibold text-sm mt-4 transition-colors">
                Siteyi Ziyaret Et <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
           </div>
        </div>
        

        <!-- Bek Akademi (Tam Genişlik Olarak Güncellendi) -->
        <div class="bg-[#0f172a] border border-slate-800 rounded-xl p-6 flex flex-col sm:flex-row items-start gap-6 hover:border-green-500/50 hover:shadow-[0_0_20px_rgba(34,197,94,0.1)] transition-all group lg:col-span-2">
           <div class="w-full sm:w-64 h-48 sm:h-36 flex-shrink-0 rounded-lg overflow-hidden bg-slate-900 border border-slate-800 relative cursor-zoom-in">
             <img src="/bek-web.png" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100" alt="Bek Akademi" data-lightbox />
           </div>
           <div class="flex flex-col h-full justify-center">
              <div>
                <span class="text-[10px] font-bold text-green-400 uppercase tracking-wider bg-green-950 px-2 py-0.5 rounded border border-green-900">Kurumsal Web Sitesi</span>
                <h3 class="text-xl font-bold text-white mt-2 group-hover:text-green-400 transition-colors leading-tight">Bek Eğitim Akademi</h3>
                <p class="text-sm text-slate-400 mt-2 leading-relaxed">
                  Kurumun eğitim felsefesini yansıtan modern dijital vitrini. <span class="text-slate-300 font-medium">(Öğrenci takip sistemi ve finansal yönetim paneli geliştirme aşamasındadır.)</span>
                </p>
              </div>
              <a href="https://www.bekegitimakademi.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-green-400 hover:text-green-300 font-semibold text-sm mt-4 transition-colors">
                Siteyi İncele <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
           </div>
        </div>

        

      </div>
    </div>

    <!-- KARANLIK TEMA CTA (Ortak Harekete Geçirici Kutu) -->
    <div class="mt-28 max-w-5xl mx-auto rounded-3xl p-10 lg:p-14 text-center shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden bg-[#0f172a] border border-slate-800">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-950"></div>
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-900/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4">Sıradaki Proje Sizin Olsun</h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-8 font-medium">İhtiyacınıza uygun teknoloji çözümünü birlikte tasarlayalım. Fikrinizi gerçeğe dönüştürmek için hemen tanışalım.</p>
        <a href="/iletisim" class="inline-flex items-center gap-2 px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 rounded-xl font-extrabold transition-transform hover:-translate-y-1 shadow-[0_0_15px_rgba(6,182,212,0.4)]">
          Projeyi Konuşalım
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>

  </section>

  <!-- PROFESYONEL LIGHTBOX (POP-UP) MODÜLÜ -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-[#0b1120]/95 backdrop-blur-sm hidden flex-col justify-center items-center opacity-0 transition-opacity duration-300">
     <!-- Kapatma Butonu -->
     <button id="lightbox-close" class="absolute top-6 right-6 text-slate-400 hover:text-cyan-400 transition-colors bg-slate-900/50 rounded-full p-2 border border-slate-800">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
     </button>
     <!-- Büyütülen Resim -->
     <img id="lightbox-img" src="" class="max-w-[95vw] max-h-[90vh] object-contain rounded-xl shadow-[0_0_50px_rgba(0,0,0,0.8)] transform scale-95 transition-transform duration-300 border border-slate-800" alt="Proje Detayı" />
  </div>

  <!-- LIGHTBOX İÇİN JAVASCRIPT -->
  <script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll('img[data-lightbox]');

    // Resimlere tıklanınca açılma fonksiyonu
    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const src = trigger.getAttribute('src');
        if(src) {
          lightboxImg.src = src;
          lightbox?.classList.remove('hidden');
          // Animasyon için hafif gecikme
          setTimeout(() => {
            lightbox?.classList.remove('opacity-0');
            lightboxImg?.classList.remove('scale-95');
            lightboxImg?.classList.add('scale-100');
          }, 20);
        }
      });
    });

    // Kapatma Fonksiyonu
    const closeLightbox = () => {
       lightbox?.classList.add('opacity-0');
       lightboxImg?.classList.remove('scale-100');
       lightboxImg?.classList.add('scale-95');
       setTimeout(() => {
         lightbox?.classList.add('hidden');
         if(lightboxImg) lightboxImg.src = '';
       }, 300);
    };

    closeBtn?.addEventListener('click', closeLightbox);
    
    // Boşluğa veya ESC tuşuna basınca kapatma
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    
    document.addEventListener('keydown', (e) => {
       if(e.key === "Escape" && !lightbox?.classList.contains('hidden')) {
          closeLightbox();
       }
    });
  </script>

</MainLayout>